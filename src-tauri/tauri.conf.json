{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zed Account Manager",
  "version": "0.1.0",
  "identifier": "dev.local.zed-account-manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Zed Account Manager",
        "width": 840,
        "height": 860,
        "minWidth": 600,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
